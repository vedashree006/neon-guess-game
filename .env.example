# Copy to ".env" and fill in. NEVER commit ".env" (it is in .gitignore).
# Every value is optional except the two ADMIN_* lines if you want the dashboard.

# ---- Environment -------------------------------------------------------------
# "production" turns on Secure cookies and HSTS. Needs HTTPS in front of the app.
APP_ENV=production
# Override only if you must (defaults: true in production, false otherwise).
#COOKIE_SECURE=true
# Set true ONLY when a reverse proxy you control (Caddy, nginx, a PaaS router) sits in front.
# It then trusts the last X-Forwarded-For entry for in-memory rate limiting.
TRUST_PROXY=false

# ---- Admin dashboard (disabled until BOTH are set) ----------------------------
ADMIN_USERNAME=
# Generate with:  mvn -q compile && java -cp target/classes com.vedashree.game.security.PasswordHasher
ADMIN_PASSWORD_HASH=
ADMIN_IDLE_MINUTES=15
ADMIN_MAX_SESSION_MINUTES=120

# ---- Sessions and analytics ---------------------------------------------------
SESSION_TIMEOUT_MINUTES=30
ANALYTICS_ACTIVE_WINDOW_SECONDS=300
ANALYTICS_VISIT_TIMEOUT_MINUTES=30
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_COOKIE_DAYS=180
DASHBOARD_REFRESH_SECONDS=15

# ---- Cookie consent -----------------------------------------------------------
# Increase when you change the privacy/cookie text: everybody is asked again.
CONSENT_POLICY_VERSION=1
CONSENT_MAX_AGE_DAYS=180
CONSENT_LOG_RETENTION_DAYS=1095

# ---- Database and backups -----------------------------------------------------
# Folder for the H2 database files. Docker sets /data (a volume).
#NEON_DB_DIR=/data
# 0 disables the built-in rolling backups.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
#BACKUP_DIR=/data/backups

# ---- Only for docker-compose with the "https" profile (Caddy) -----------------
#DOMAIN=game.example.com   # required only with --profile https
